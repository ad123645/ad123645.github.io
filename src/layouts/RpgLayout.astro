---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/rpg.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RPG 阅览大厅',
  description = '一个可以走动浏览的首页入口。',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="shell page-block rpg-shell">
    <slot />
  </section>
</BaseLayout>
