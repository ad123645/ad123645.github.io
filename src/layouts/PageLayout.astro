---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  intro?: string;
}

const { title, description, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="shell page-block page-shell">
    <header class="page-banner card-surface">
      <div class="banner-copy stack">
        <p class="banner-kicker">Index page</p>
        <div>
          <h1 class="page-title">{title}</h1>
          {intro && <p class="page-intro">{intro}</p>}
        </div>
      </div>

      <div class="banner-note">
        <p>这里保持简洁、连续、易查找。RPG 是前厅，正文和索引仍然是馆藏本体。</p>
      </div>
    </header>

    <slot />
  </section>
</BaseLayout>

<style>
  .page-shell {
    display: grid;
    gap: 2rem;
  }

  .page-banner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.8fr);
    gap: 1rem;
    padding: 1.35rem 1.4rem;
  }

  .banner-copy,
  .banner-note {
    position: relative;
    z-index: 1;
  }

  .banner-kicker,
  .banner-note p {
    margin: 0;
    color: var(--text-muted);
  }

  .banner-kicker {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .banner-note {
    display: flex;
    align-items: end;
    justify-content: end;
    text-align: left;
  }

  .banner-note p {
    max-width: 18rem;
    padding: 0.85rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
    background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 820px) {
    .page-banner {
      grid-template-columns: 1fr;
    }

    .banner-note {
      justify-content: start;
    }
  }
</style>
