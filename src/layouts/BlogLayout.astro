---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import RelatedPostList from '@/components/blog/RelatedPostList.astro';
import CatalogTrail from '@/components/catalog/CatalogTrail.astro';
import CatalogBadge from '@/components/catalog/CatalogBadge.astro';
import { getCatalogNodeByCode } from '@/data/catalog/clc';
import { getSiblingCatalogNodes } from '@/features/catalog/helpers';
import { withBase } from '@/utils/paths';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  catalogCode?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
  shelves?: CollectionEntry<'shelves'>[];
}

const props = Astro.props;
const catalogNode = getCatalogNodeByCode(props.catalogCode);
const siblingShelves = getSiblingCatalogNodes(props.catalogCode)
  .filter((node) => node.code !== props.catalogCode)
  .slice(0, 8);
---

<BaseLayout title={props.title} description={props.description}>
  <article class="shell page-block article-shell">
    <header class="article-banner card-surface stack">
      <p class="article-kicker">文章</p>
      <div class="stack header-content">
        <h1 class="page-title">{props.title}</h1>
        <p class="page-intro">{props.description}</p>

        {catalogNode && (
          <div class="catalog-meta stack">
            <CatalogTrail code={catalogNode.code} />
            <div class="catalog-badges">
              <CatalogBadge code={catalogNode.code} mode="solid" />
              <a href={withBase(`/catalog/${catalogNode.slug}`)} class="pill-link">查看这个分类</a>
            </div>
          </div>
        )}

        <PostMeta publishedAt={props.publishedAt} updatedAt={props.updatedAt} tags={props.tags ?? []} />
      </div>
    </header>

    <div class="article-body card-surface">
      <div class="prose article-prose">
        <slot />
      </div>
    </div>

    {catalogNode && siblingShelves.length > 0 && (
      <section class="shelf-neighbors card-surface">
        <div class="neighbor-head">
          <p class="article-kicker">相关分类</p>
          <h2>相邻书架</h2>
          <p>这篇文章所在的分类旁边，还有一些可以顺手继续看的相邻分类。</p>
        </div>
        <div class="neighbor-badges">
          {siblingShelves.map((node) => <CatalogBadge code={node.code} />)}
        </div>
      </section>
    )}


    {props.shelves && props.shelves.length > 0 && (
      <section class="shelf-neighbors card-surface curated-shelves">
        <div class="neighbor-head">
          <p class="article-kicker">专题收录</p>
          <h2>这篇文章也出现在这些专题里</h2>
          <p>分类决定它放在哪，专题书架则把它和别的内容重新放到一起看。</p>
        </div>
        <div class="curated-list">
          {props.shelves.map((shelf) => (
            <a href={withBase(`/shelves/${shelf.id}`)} class="curated-item">
              <span>{shelf.data.shelfCode}</span>
              <strong>{shelf.data.title}</strong>
              <p>{shelf.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {props.relatedPosts && props.relatedPosts.length > 0 && (
      <RelatedPostList
        posts={props.relatedPosts}
        title="同分类相关文章"
        note="可以先看同一分类下的内容，再顺手看看附近分类。"
      />
    )}

    <nav class="article-nav" aria-label="文章后续导航">
      <a href={withBase('/blog')} class="pill-link">回到博客目录</a>
      <a href={withBase('/archive')} class="pill-link">查看归档</a>
      <a href={withBase('/catalog')} class="pill-link">浏览馆藏目录</a>
      {catalogNode && <a href={withBase(`/catalog/${catalogNode.slug}`)} class="pill-link">回到当前分类</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .article-shell {
    display: grid;
    gap: 1.25rem;
  }

  .article-banner,
  .article-body,
  .shelf-neighbors {
    position: relative;
    z-index: 1;
  }

  .article-banner {
    max-width: calc(var(--content-narrow) + 6rem);
    padding: 1.35rem 1.4rem;
  }

  .header-content {
    gap: 0.9rem;
  }

  .article-kicker {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .catalog-meta {
    gap: 0.7rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
    background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
    box-shadow: var(--shadow-soft);
  }

  .catalog-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .article-body,
  .shelf-neighbors,
  .related-panel {
    max-width: calc(var(--content-narrow) + 6rem);
  }

  .article-body {
    padding: 1.6rem;
  }

  .article-prose {
    max-width: var(--content-narrow);
  }

  .shelf-neighbors {
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.85rem;
  }

  .neighbor-head {
    display: grid;
    gap: 0.3rem;
  }

  .neighbor-head h2,
  .neighbor-head p {
    margin: 0;
  }

  .neighbor-head h2 {
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .neighbor-head p:last-child {
    color: var(--text-muted);
  }

  .neighbor-badges {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }


  .curated-shelves {
    max-width: calc(var(--content-narrow) + 6rem);
  }

  .curated-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .curated-item {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
    background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
    box-shadow: var(--shadow-soft);
  }

  .curated-item span,
  .curated-item p {
    margin: 0;
    color: var(--text-muted);
  }

  .curated-item strong {
    font-size: 1rem;
    line-height: 1.4;
  }

  .article-nav {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 760px) {
    .curated-list {
      grid-template-columns: 1fr;
    }

    .article-body,
    .article-banner,
    .shelf-neighbors {
      padding: 1.15rem;
    }
  }
</style>
