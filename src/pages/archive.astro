---
import PageLayout from '@/layouts/PageLayout.astro';
import ArchiveList from '@/components/blog/ArchiveList.astro';
import { getPostsGroupedByTopCatalog, getPublishedPosts } from '@/features/blog/api/posts';
import { catalogByCode } from '@/data/catalog/clc';
import { withBase } from '@/utils/paths';

const posts = await getPublishedPosts();
const groupedByShelf = [...getPostsGroupedByTopCatalog(posts).entries()]
  .flatMap(([code, items]) => {
    const node = catalogByCode.get(code);
    return node ? [{ code, node, posts: items }] : [];
  })
  .sort((a, b) => b.posts.length - a.posts.length || a.code.localeCompare(b.code, 'zh-CN'));
---

<PageLayout
  title="归档"
  description="所有文章的归档索引"
  intro="当文章慢慢变多，这里既能按时间翻，也能沿着馆藏书架慢慢找。"
>
  <div class="section-toolbar">
    <a href={withBase('/blog')} class="pill-link">回到博客</a>
    <a href={withBase('/catalog')} class="pill-link">查看完整目录</a>
  </div>

  <div class="archive-grid">
    <section class="archive-panel card-surface">
      <div class="panel-head">
        <p class="panel-kicker">By time</p>
        <h2>按时间翻</h2>
        <p>像从最新的一叠目录卡往后翻，先看到时间，再追到具体文章。</p>
      </div>
      <ArchiveList posts={posts} />
    </section>

    <section class="catalog-panel card-surface">
      <div class="panel-head">
        <p class="panel-kicker">By shelf</p>
        <h2>按书架找</h2>
        <p>分类是秩序骨架，标签是临时书签。这里沿着书架把文章重新排一遍。</p>
      </div>

      <div class="shelf-archive-list">
        {groupedByShelf.map((group) => (
          <article class="shelf-archive-item">
            <div class="shelf-title-row">
              <div>
                <strong>{group.code}</strong>
                <span>{group.node.name}</span>
              </div>
              <a href={withBase(`/catalog/${group.node.slug}`)} class="pill-link">打开书架</a>
            </div>
            <ArchiveList posts={group.posts} />
          </article>
        ))}
      </div>
    </section>
  </div>

  <style>
    .archive-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .archive-panel,
    .catalog-panel {
      padding: 1rem 1.15rem;
      display: grid;
      gap: 1rem;
    }

    .panel-head {
      display: grid;
      gap: 0.35rem;
    }

    .panel-kicker,
    .panel-head p:last-child,
    .shelf-title-row span {
      margin: 0;
      color: var(--text-muted);
    }

    .panel-kicker {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .panel-head h2 {
      margin: 0;
      font-size: 1.45rem;
      line-height: 1.2;
    }

    .shelf-archive-list {
      display: grid;
      gap: 1rem;
    }

    .shelf-archive-item {
      display: grid;
      gap: 0.75rem;
      padding-top: 0.2rem;
    }

    .shelf-archive-item + .shelf-archive-item {
      border-top: 1px solid color-mix(in srgb, var(--line) 78%, white 22%);
      padding-top: 1rem;
    }

    .shelf-title-row {
      display: flex;
      justify-content: space-between;
      gap: 0.8rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .shelf-title-row div {
      display: grid;
      gap: 0.15rem;
    }

    .shelf-title-row strong {
      font-size: 1rem;
      line-height: 1.2;
    }

    @media (max-width: 980px) {
      .archive-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PageLayout>
