---
import PageLayout from '@/layouts/PageLayout.astro';
import ShelfCard from '@/components/shelves/ShelfCard.astro';
import { getPublishedShelves } from '@/features/shelves/api/getShelves';

const shelves = await getPublishedShelves();
const overview = [
  { label: '专题书架数', value: String(shelves.length).padStart(2, '0') },
  { label: '专题选取方式', value: '人工选取' },
  { label: '浏览方式', value: '请自由挑选感兴趣的专题浏览' },
];
---

<PageLayout
  title="专题书架"
  description="把不同分类的内容按主题重新整理的页面"
  intro="这里会把不同分类、不同类型的内容按主题重新整理，方便集中阅读。"
>
  <div class="overview-grid info-grid three">
    {overview.map((item) => (
      <div class="info-card card-surface overview-card">
        <p class="info-kicker">{item.label}</p>
        <strong>{item.value}</strong>
      </div>
    ))}
  </div>

  <section class="shelf-grid">
    {shelves.map((shelf) => <ShelfCard shelf={shelf} />)}
  </section>

  <style>
    .overview-card { display: grid; gap: 0.3rem; }
    .overview-card strong { font-size: 1.45rem; line-height: 1; }
    .shelf-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    @media (max-width: 980px) {
      .shelf-grid { grid-template-columns: 1fr; }
    }
  </style>
</PageLayout>
