---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import CatalogBadge from '@/components/catalog/CatalogBadge.astro';
import { flatCatalogNodes, getCatalogNodeBySlug, getCatalogPath } from '@/data/catalog/clc';
import { getPublishedPosts } from '@/features/blog/api/posts';
import { getCatalogNodeSummary, getPostsByCatalogCode, getSiblingCatalogNodes } from '@/features/catalog/helpers';
import { withBase } from '@/utils/paths';

export async function getStaticPaths() {
  const uniqueNodes = Array.from(new Map(flatCatalogNodes.map((node) => [node.slug, node])).values());

  return uniqueNodes.map((node) => ({
    params: { slug: node.slug },
  }));
}

const node = getCatalogNodeBySlug(Astro.params.slug);

if (!node) {
  throw new Error(`Catalog node not found: ${Astro.params.slug}`);
}

const posts = await getPublishedPosts();
const summary = getCatalogNodeSummary(node, posts);
const relatedPosts = getPostsByCatalogCode(posts, node.code, { includeDescendants: true });
const trail = getCatalogPath(node.code);
const siblings = getSiblingCatalogNodes(node.code).filter((item) => item.code !== node.code);
const activeChildren = summary.childrenWithCount.filter((child) => child.count > 0);
const levelLabelMap: Record<number, string> = { 1: '一级分区', 2: '二级类', 3: '三级类', 4: '四级类', 5: '细分类' };
const levelLabel = levelLabelMap[node.level] ?? `第 ${node.level} 层`;
const introCopy =
  node.level === 1
    ? '一级分类会把下级分类里的文章一起收进来。'
    : summary.childrenWithCount.length > 0
      ? '这一层会保留上级路径，也会继续展开下级分类。'
      : '这一层已经比较具体，页面里会保留它所属的上级路径。';
---

<PageLayout
  title={`${node.code} · ${node.name}`}
  description={`馆藏目录 ${node.code} ${node.name}`}
  intro={`这里是 ${node.code} ${node.name} 的分类页。${introCopy}`}
>
  <div class="section-toolbar">
    <a href={withBase('/catalog')} class="pill-link">回到完整目录</a>
    {trail[0] && trail[0].code !== node.code && (
      <a href={withBase(`/catalog/${trail[0].slug}`)} class="pill-link">返回 {trail[0].code} 一级分类</a>
    )}
    <a href={withBase('/blog')} class="pill-link">回到博客</a>
  </div>

  <div class="detail-grid">
    <section class="node-hero card-surface">
      <div class="node-main">
        <p class="node-kicker">{levelLabel}</p>
        <h2>{node.code}</h2>
        <p class="node-name">{node.name}</p>
      </div>

      <div class="node-side">
        <div class="metric-card">
          <span>文章数量</span>
          <strong>{String(relatedPosts.length).padStart(2, '0')}</strong>
        </div>
        <div class="metric-card">
          <span>下级分类</span>
          <strong>{String(summary.childrenWithCount.length).padStart(2, '0')}</strong>
        </div>
        <div class="metric-card">
          <span>已有文章的下级分类</span>
          <strong>{String(activeChildren.length).padStart(2, '0')}</strong>
        </div>
      </div>
    </section>

    <aside class="detail-aside card-surface">
      <div class="aside-block">
        <p class="node-kicker">馆藏路径</p>
        <div class="trail-row">
          {trail.map((item) => (
            <CatalogBadge code={item.code} />
          ))}
        </div>
      </div>

      {siblings.length > 0 && (
        <div class="aside-block">
          <p class="node-kicker">同层相邻分类</p>
          <div class="trail-row compact">
            {siblings.slice(0, 8).map((item) => (
              <CatalogBadge code={item.code} />
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>

  {node.note && (
    <section class="scope-panel card-surface">
      <div class="panel-head">
        <p class="node-kicker">分类说明</p>
      </div>
      <div class="scope-note">
        <p>{node.note}</p>
      </div>
    </section>
  )}

  {summary.childrenWithCount.length > 0 && (
    <section class="child-panel card-surface">
      <div class="panel-head">
        <p class="node-kicker">下级分类</p>
        <p>下级分类会完整保留，即使当前还没有文章，也不会先从目录里移走。</p>
      </div>
      <div class="child-grid">
        {summary.childrenWithCount.map((child) => (
          <a href={withBase(`/catalog/${child.slug}`)} class={`child-item ${child.count > 0 ? 'active' : ''}`}>
            <span>{child.code}</span>
            <strong>{child.name}</strong>
            <em>{child.count} 篇</em>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="post-section">
    <div class="section-heading">
      <h3>这个分类下的文章</h3>
      <p>{relatedPosts.length > 0 ? '下面这些文章会归到这个分类下。一级分类也会自动收拢下级分类里的文章。' : '这个分类下暂时还没有文章，但目录位置已经先留好了。'}</p>
    </div>

    {relatedPosts.length > 0 ? (
      <div class="post-grid">
        {relatedPosts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty card-surface">
        <p>这个分类现在还没有文章，后面写到时可以直接放进来。</p>
      </div>
    )}
  </section>

  <style>
    .detail-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.75fr);
      gap: 1rem;
    }

    .node-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.9fr);
      gap: 1rem;
      padding: 1.25rem;
    }

    .node-main,
    .node-side,
    .metric-card,
    .detail-aside {
      position: relative;
      z-index: 1;
    }

    .node-kicker,
    .section-heading p,
    .panel-head p:last-child,
    .empty p {
      margin: 0;
      color: var(--text-muted);
    }

    .node-kicker {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .node-main h2 {
      margin: 0.25rem 0 0;
      font-size: clamp(2rem, 4vw, 2.7rem);
      line-height: 1;
    }

    .node-name {
      margin: 0.5rem 0 0;
      font-size: 1.05rem;
    }

    .node-side {
      display: grid;
      gap: 0.8rem;
      align-content: start;
    }

    .metric-card,
    .detail-aside,
    .scope-panel,
    .child-panel,
    .empty {
      padding: 1rem 1.05rem;
    }

    .scope-panel {
      display: grid;
      gap: 0.75rem;
    }

    .metric-card,
    .aside-block {
      display: grid;
      gap: 0.2rem;
      padding: 0.9rem 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .detail-aside {
      display: grid;
      gap: 0.9rem;
      align-content: start;
    }

    .scope-note {
      display: grid;
      gap: 0.25rem;
      padding: 0.9rem 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .scope-note p {
      margin: 0;
      color: var(--text-muted);
      line-height: 1.8;
    }

    .metric-card strong {
      font-size: 1.5rem;
      line-height: 1;
    }

    .trail-row {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
      margin-top: 0.75rem;
    }

    .compact {
      gap: 0.5rem;
    }

    .panel-head {
      display: grid;
      gap: 0.25rem;
      margin-bottom: 0.9rem;
    }

    .scope-panel .panel-head {
      margin-bottom: 0;
    }

    .child-grid,
    .post-grid {
      display: grid;
      gap: 0.9rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .child-item {
      display: grid;
      gap: 0.35rem;
      padding: 0.85rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .child-item span,
    .child-item em {
      color: var(--text-muted);
      font-style: normal;
    }

    .child-item.active {
      border-color: color-mix(in srgb, var(--accent) 18%, var(--line) 82%);
      background: color-mix(in srgb, var(--accent-soft) 26%, white 74%);
    }

    .post-section {
      display: grid;
      gap: 1rem;
    }

    .section-heading {
      display: grid;
      gap: 0.35rem;
    }

    .section-heading h3 {
      margin: 0;
      font-size: 1.4rem;
    }

    @media (max-width: 1080px) {
      .detail-grid,
      .node-hero,
      .child-grid,
      .post-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PageLayout>
