---
import RpgLayout from '@/layouts/RpgLayout.astro';
import Button from '@/components/ui/Button.astro';
import RpgCanvas from '@/features/rpg/components/RpgCanvas';

const roomCards = [
  {
    title: '大厅',
    text: '负责分流和欢迎，相当于这个入口的起点。',
  },
  {
    title: '图书馆',
    text: '这里更像过渡区域，会把你带到真正的分类书架。',
  },
  {
    title: '藏书室',
    text: '主要分类都排在这里，找方向会比在大厅里更直接。',
  },
  {
    title: '游戏室',
    text: '放小游戏和实验内容，不过整体风格还是和全站保持一致。',
  },
];
---

<RpgLayout title="RPG 阅览大厅" description="WASD 移动，E 键交互。">
  <div class="rpg-grid">
    <section class="stack hero-side">
      <div class="stack">
        <p class="page-kicker">RPG 入口</p>
        <h1 class="page-title">RPG 阅览大厅</h1>
        <p class="page-intro">
          这是一个可以走动浏览的页面原型。你可以在大厅、图书馆、藏书室和游戏室之间移动。
        </p>
      </div>

      <div class="hero-actions">
        <Button href="/blog">去博客</Button>
        <Button href="/games">去游戏区</Button>
        <Button href="/about">去关于页</Button>
        <Button href="/catalog">去馆藏目录</Button>
      </div>

      <div class="info-grid three room-grid">
        {roomCards.map((item) => (
          <article class="info-card card-surface room-card">
            <p class="info-kicker">区域</p>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="card-surface control-card">
      <p class="note-kicker">操作说明</p>
      <ul>
        <li>WASD 或方向键移动</li>
        <li>E 键交互</li>
        <li>门、告示牌和书架入口都能单独交互</li>
        <li>当前版本先确认结构和交互，再慢慢替换素材</li>
        <li>图书馆会把你带到藏书室，主要分类会在那边展开</li>
      </ul>
      <p class="control-foot">还在构思中……如果有建议可以到“关于此博客”页面中寻找联系方式联系我！</p>
    </aside>
  </div>

  <RpgCanvas client:load />

  <p class="rpg-note">
    操作方式：WASD / 方向键移动，E 键交互。当前版本先用简单图形占位，后面再慢慢补素材。
  </p>

  <style>
    .rpg-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.88fr);
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .hero-side,
    .control-card {
      align-content: start;
    }

    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .page-kicker,
    .note-kicker,
    .control-foot,
    .room-card p:last-child,
    .rpg-note {
      color: var(--text-muted);
    }

    .page-kicker,
    .note-kicker {
      margin: 0;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .room-grid {
      margin-top: 0.15rem;
    }

    .room-card {
      display: grid;
      gap: 0.45rem;
    }

    .room-card h2,
    .room-card p:last-child,
    .control-card ul {
      margin: 0;
    }

    .room-card h2 {
      font-size: 1.05rem;
      line-height: 1.2;
    }

    .control-card {
      display: grid;
      gap: 1rem;
      padding: 1rem 1.1rem;
    }

    .control-card > * {
      position: relative;
      z-index: 1;
    }

    .control-card ul {
      padding-left: 1.2rem;
      color: var(--text);
    }

    .control-foot,
    .rpg-note {
      margin: 0;
    }

    .rpg-note {
      margin-top: 1rem;
    }

    @media (max-width: 980px) {
      .rpg-grid,
      .room-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</RpgLayout>
