---
import RpgLayout from '@/layouts/RpgLayout.astro';
import Button from '@/components/ui/Button.astro';
import RpgCanvas from '@/features/rpg/components/RpgCanvas';

const roomCards = [
  {
    title: '大厅',
    text: '负责分流与欢迎，是沉浸式入口的前厅。',
  },
  {
    title: '图书馆',
    text: '连接文章目录、书架说明和阅读空间。',
  },
  {
    title: '游戏室',
    text: '承接小作品与实验页面，但风格继续服从整站。',
  },
];
---

<RpgLayout title="RPG 阅览大厅" description="WASD 移动，E 交互。">
  <div class="rpg-grid">
    <section class="stack hero-side">
      <div class="stack">
        <p class="page-kicker">Immersive entry</p>
        <h1 class="page-title">RPG 阅览大厅</h1>
        <p class="page-intro">
          这是首页的沉浸式入口原型。你可以在大厅、图书馆和游戏室之间移动。
          右侧的页面系统仍然保持统一，不会突然变成另一套宇宙。
        </p>
      </div>

      <div class="hero-actions">
        <Button href="/blog">去博客</Button>
        <Button href="/games">去游戏页</Button>
        <Button href="/about">去关于页</Button>
      </div>

      <div class="info-grid three room-grid">
        {roomCards.map((item) => (
          <article class="info-card card-surface room-card">
            <p class="info-kicker">Room</p>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="card-surface control-card">
      <p class="note-kicker">操作说明</p>
      <ul>
        <li>WASD 或方向键移动</li>
        <li>E 键交互</li>
        <li>门、告示牌、书架入口都是独立对象</li>
        <li>当前版本优先验证结构，再逐步替换贴图</li>
      </ul>
      <p class="control-foot">目标不是把博客伪装成游戏，而是给首页增加一层能走动的空间感。</p>
    </aside>
  </div>

  <RpgCanvas client:load />

  <p class="rpg-note">
    操作方式：WASD / 方向键移动，E 键交互。当前版本使用几何占位物体，但对象分层已经按未来可替换贴图的方式整理。
  </p>

  <style>
    .rpg-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.88fr);
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .hero-side,
    .control-card {
      align-content: start;
    }

    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .page-kicker,
    .note-kicker,
    .control-foot,
    .room-card p:last-child,
    .rpg-note {
      color: var(--text-muted);
    }

    .page-kicker,
    .note-kicker {
      margin: 0;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .room-grid {
      margin-top: 0.15rem;
    }

    .room-card {
      display: grid;
      gap: 0.45rem;
    }

    .room-card h2,
    .room-card p:last-child,
    .control-card ul {
      margin: 0;
    }

    .room-card h2 {
      font-size: 1.05rem;
      line-height: 1.2;
    }

    .control-card {
      display: grid;
      gap: 1rem;
      padding: 1rem 1.1rem;
    }

    .control-card > * {
      position: relative;
      z-index: 1;
    }

    .control-card ul {
      padding-left: 1.2rem;
      color: var(--text);
    }

    .control-foot,
    .rpg-note {
      margin: 0;
    }

    .rpg-note {
      margin-top: 1rem;
    }

    @media (max-width: 980px) {
      .rpg-grid,
      .room-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</RpgLayout>
