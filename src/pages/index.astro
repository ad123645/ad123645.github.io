---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import ModeSwitch from '@/components/site/ModeSwitch.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import EntryCard from '@/components/site/EntryCard.astro';
import { getPostTags, getPublishedPosts } from '@/features/blog/api/posts';
import PostCard from '@/components/blog/PostCard.astro';
import CatalogCard from '@/components/catalog/CatalogCard.astro';
import { withBase } from '@/utils/paths';
import { getCatalogSummary } from '@/features/catalog/helpers';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const tags = (await getPostTags()).slice(0, 6);
const catalogSummary = getCatalogSummary(allPosts);
const activeCatalog = catalogSummary.filter((node) => node.count > 0).slice(0, 4);

const rooms = [
  {
    note: 'Reading stacks',
    title: '博客文章',
    href: '/blog',
    description: '正式文章、随手笔记、阅读记录，都收在这里。',
  },
  {
    note: 'Side room',
    title: '游戏页',
    href: '/games',
    description: '放实验作品、游戏原型，以及和交互有关的碎片。',
  },
  {
    note: 'Index cabinet',
    title: '关于页',
    href: '/about',
    description: '把站点缘起、个人简介与这间小馆的说明放进档案柜。',
  },
];

const stats = [
  { label: '已上架文章', value: String(allPosts.length).padStart(2, '0') },
  { label: '开放房间', value: '03' },
  { label: '浏览模式', value: '双轨' },
];

const principles = [
  {
    kicker: 'Visual system',
    title: '像同一座馆，而不是拼接楼层',
    text: '首页、正文、游戏页都共享同一套纸面、描边、圆角与留白。',
  },
  {
    kicker: 'Content first',
    title: '先有目录，再有陈列柜',
    text: 'RPG 是入口层，真正的长期价值仍落在文章、项目与索引结构。',
  },
  {
    kicker: 'Expandable',
    title: '现在能跑，以后能长',
    text: '场景对象和组件结构尽量拆开，为日后换贴图、加分类、添交互留空间。',
  },
];

const routes = [
  { title: '大厅', note: '沉浸式入口', href: '/rpg' },
  { title: '图书馆', note: '文章与阅读记录', href: '/blog' },
  { title: '游戏室', note: '实验作品与 demo', href: '/games' },
  { title: '档案柜', note: '关于与站点说明', href: '/about' },
];
---

<BaseLayout title="首页">
  <section class="shell hero page-block">
    <div class="hero-grid">
      <div class="hero-copy card-surface stack">
        <p class="eyebrow">Library · Reading Room · Archive</p>
        <h1>这很调和</h1>
        <p class="intro">
          一个偏向图书馆、阅览室与档案馆气质的个人博客。
          你可以从大厅慢慢逛，也可以直接翻开目录。
        </p>

        <div class="actions">
          <Button href="/rpg" variant="primary">进入阅览大厅</Button>
          <Button href="/blog">直接浏览文章</Button>
        </div>

        <div class="stat-row" aria-label="站点概览">
          {stats.map((item) => (
            <div class="stat-chip">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        <div class="hero-bottom">
          <p class="soft-note">大厅支持 RPG 式浏览，旁边也保留简洁入口，不把任何访客锁在旋转门里。</p>
          <ModeSwitch />
        </div>
      </div>

      <aside class="card-surface catalog-panel" aria-label="馆内导览">
        <div class="stack panel-head">
          <p class="panel-kicker">馆内导览</p>
          <h2>先给访客一张索引卡</h2>
        </div>

        <div class="route-map" aria-hidden="true">
          <div class="route-node hall current">大厅</div>
          <div class="route-link left"></div>
          <div class="route-link right"></div>
          <div class="route-link down"></div>
          <div class="route-node library">图书馆</div>
          <div class="route-node game">游戏室</div>
          <div class="route-node archive">档案柜</div>
        </div>

        <ul class="catalog-list">
          {routes.map((route) => (
            <li>
              <strong>{route.title}</strong>
              <span>{route.note}</span>
              <a href={withBase(route.href)}>打开</a>
            </li>
          ))}
        </ul>

        <div class="tag-strip">
          {tags.map((tag) => (
            <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>{tag}</a>
          ))}
        </div>

        <div class="quote-box">
          <p>希望每个页面都像抽屉式目录的一格，打开时有纸张的温度，也有秩序感。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="shell page-block principles-block">
    <SectionTitle
      eyebrow="设计原则"
      title="让气质、结构与功能一起调和"
      intro="把站点的骨架、皮肤和入口方式同时收拢，避免内容系统和小游戏系统互相扯袖子。"
    />

    <div class="info-grid three">
      {principles.map((item) => (
        <article class="info-card card-surface principle-card">
          <p class="info-kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell page-block">
    <SectionTitle
      eyebrow="馆藏索引"
      title="从不同的门进入同一座馆"
      intro="把博客、游戏、关于页都做成同一套材质与秩序，而不是互相串门的陌生楼层。"
    />

    <div class="entry-grid">
      {rooms.map((room) => <EntryCard {...room} />)}
    </div>
  </section>

  <section class="shell page-block catalog-block">
    <SectionTitle
      eyebrow="馆藏目录"
      title="让全量分类真正住进博客"
      intro="一级总架和二级子类都已经接入。首页只先摆出最近常被翻动的几架书，其余目录收在完整索引页里。"
    />

    <div class="catalog-home-grid">
      <div class="catalog-cards">
        {activeCatalog.map((node) => <CatalogCard node={node} compact />)}
      </div>

      <aside class="card-surface catalog-side-note">
        <p class="side-kicker">目录卡柜</p>
        <h3>分类是书架，标签是书签</h3>
        <p>文章现在除了标签，还会挂到完整的馆藏分类上。你可以按时间找，也可以按书架找。</p>
        <div class="side-links">
          <a href={withBase('/catalog')} class="pill-link">打开完整目录</a>
          <a href={withBase('/archive')} class="pill-link">去归档页</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="shell page-block recent-block">
    <div class="recent-head">
      <SectionTitle
        eyebrow="最近文章"
        title="先把桌面上的目录卡整理好"
        intro="首页不急着解释一切，先让人看到最新的书脊和标签。"
      />
      <div class="recent-actions">
        <a href={withBase('/archive')} class="pill-link">查看完整归档</a>
        <a href={withBase('/blog')} class="pill-link">进入博客目录</a>
      </div>
    </div>

    <div class="recent-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <style>
    .hero {
      padding-top: 2rem;
      padding-bottom: 1rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.42fr) minmax(19rem, 0.92fr);
      gap: 1rem;
      align-items: stretch;
    }

    .hero-copy,
    .catalog-panel {
      padding: 1.5rem;
      min-height: 100%;
    }

    .hero-copy {
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 38%),
        color-mix(in srgb, var(--panel) 90%, white 10%);
    }

    .eyebrow,
    .panel-kicker {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    h1 {
      margin: 0;
      font-size: clamp(3rem, 7vw, 5.4rem);
      line-height: 0.98;
      letter-spacing: 0.01em;
    }

    .intro,
    .soft-note,
    .quote-box p,
    .principle-card p:last-child {
      margin: 0;
      color: var(--text-muted);
    }

    .intro {
      font-size: 1.08rem;
      max-width: 40rem;
    }

    .actions,
    .recent-actions {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .stat-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .stat-chip {
      display: grid;
      gap: 0.2rem;
      padding: 0.8rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .stat-chip strong {
      font-size: 1.25rem;
      line-height: 1;
    }

    .stat-chip span {
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    .hero-bottom {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .soft-note {
      max-width: 30rem;
      font-size: 0.96rem;
    }

    .catalog-panel {
      display: grid;
      gap: 1rem;
      align-content: start;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.2), transparent 32%),
        color-mix(in srgb, var(--panel-strong) 88%, white 12%);
    }

    .panel-head,
    .route-map,
    .catalog-list,
    .tag-strip,
    .quote-box {
      position: relative;
      z-index: 1;
    }

    .panel-head h2,
    .catalog-list,
    .catalog-list li,
    .quote-box p {
      margin: 0;
    }

    .route-map {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      align-items: center;
      min-height: 10.5rem;
      padding: 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px dashed color-mix(in srgb, var(--line-strong) 84%, white 16%);
      background: color-mix(in srgb, var(--panel) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .route-node {
      display: grid;
      place-items: center;
      min-height: 3rem;
      padding: 0.35rem 0.6rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel-strong) 90%, white 10%);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .route-node.current {
      color: var(--text);
      border-color: color-mix(in srgb, var(--accent) 24%, var(--line) 76%);
      background: color-mix(in srgb, var(--accent-soft) 44%, white 56%);
      font-weight: 700;
    }

    .route-node.hall { grid-column: 2; grid-row: 1; }
    .route-node.library { grid-column: 1; grid-row: 2; }
    .route-node.game { grid-column: 3; grid-row: 2; }
    .route-node.archive { grid-column: 2; grid-row: 3; }

    .route-link {
      justify-self: center;
      align-self: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent) 14%, var(--line) 86%);
    }

    .route-link.left,
    .route-link.right {
      width: 100%;
      height: 2px;
      grid-row: 2;
    }

    .route-link.left { grid-column: 2; transform: translateX(-34%); }
    .route-link.right { grid-column: 2; transform: translateX(34%); }
    .route-link.down {
      width: 2px;
      height: 100%;
      grid-column: 2;
      grid-row: 2;
      transform: translateY(34%);
    }

    .catalog-list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: 0.85rem;
    }

    .catalog-list li {
      display: grid;
      gap: 0.18rem;
      padding: 0.9rem 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel) 90%, white 10%);
      box-shadow: var(--shadow-soft);
    }

    .catalog-list span,
    .catalog-list a {
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .catalog-list a {
      color: var(--accent);
      justify-self: start;
      margin-top: 0.15rem;
    }

    .tag-strip {
      display: flex;
      gap: 0.55rem;
      flex-wrap: wrap;
    }

    .tag-strip a {
      display: inline-flex;
      align-items: center;
      min-height: 2.1rem;
      padding: 0 0.75rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel) 88%, white 12%);
      color: var(--text-muted);
      font-size: 0.84rem;
    }

    .quote-box {
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px dashed color-mix(in srgb, var(--line-strong) 86%, white 14%);
      background: color-mix(in srgb, var(--accent-warm) 55%, white 45%);
    }

    .principles-block {
      padding-top: 0.5rem;
    }

    .principle-card {
      padding: 1.05rem 1.1rem;
      display: grid;
      gap: 0.65rem;
    }

    .principle-card h3 {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.25;
    }


    .catalog-home-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.82fr);
      gap: 1rem;
    }

    .catalog-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .catalog-side-note {
      padding: 1.2rem;
      display: grid;
      gap: 0.9rem;
      align-content: start;
    }

    .catalog-side-note > * {
      position: relative;
      z-index: 1;
    }

    .side-kicker,
    .catalog-side-note p {
      margin: 0;
      color: var(--text-muted);
    }

    .side-kicker {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .catalog-side-note h3 {
      margin: 0;
      font-size: 1.3rem;
      line-height: 1.25;
    }

    .side-links {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .entry-grid,
    .recent-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .recent-head {
      display: flex;
      gap: 1rem;
      align-items: end;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    @media (max-width: 980px) {
      .hero-grid,
      .entry-grid,
      .recent-grid,
      .catalog-home-grid,
      .catalog-cards {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .stat-row {
        grid-template-columns: 1fr;
      }

      .route-map {
        min-height: 11.5rem;
      }
    }
  </style>
</BaseLayout>
