---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import ModeSwitch from '@/components/site/ModeSwitch.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import EntryCard from '@/components/site/EntryCard.astro';
import { getPostTags, getPublishedPosts } from '@/features/blog/api/posts';
import PostCard from '@/components/blog/PostCard.astro';
import CatalogCard from '@/components/catalog/CatalogCard.astro';
import { withBase } from '@/utils/paths';
import { getCatalogSummary } from '@/features/catalog/helpers';
import { getPublishedShelves } from '@/features/shelves/api/getShelves';
import ShelfCard from '@/components/shelves/ShelfCard.astro';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const tags = (await getPostTags()).slice(0, 6);
const catalogSummary = getCatalogSummary(allPosts);
const activeCatalog = catalogSummary.filter((node) => node.count > 0).slice(0, 4);

const allShelves = await getPublishedShelves();
const shelves = allShelves.slice(0, 2);

const rooms = [
  {
    note: '文章入口',
    title: '博客文章',
    href: '/blog',
    description: '文章、笔记和阅读记录都从这里进入。',
  },
  {
    note: '实验区',
    title: '游戏页',
    href: '/games',
    description: '这里放试作、demo 和一些交互方向的内容。',
  },
  {
    note: '站点说明',
    title: '关于页',
    href: '/about',
    description: '这里集中放站点说明和一些基础信息。',
  },
];

const stats = [
  { label: '已上架文章数', value: String(allPosts.length).padStart(2, '0') },
  { label: '已整理专题数', value: String(allShelves.length).padStart(2, '0') },
  { label: '当前博客版本v2.0', value: '版本更新' },
];

const principles = [
  {
    kicker: '一触即达',
    title: '全站检索',
    text: '使用快捷键或首页按钮可打开全站检索功能，支持搜索书架、标签、博客文章等内容',
  },
  {
    kicker: '图书馆就像是天堂的样子',
    title: '馆藏',
    text: '按照中图索引号增加了数万细目，计划在未来能真正让读者们可以阅读到博主的pdf版本藏书',
  },
  {
    kicker: '还在尝试中',
    title: 'RPG浏览模式',
    text: 'RPG 入口只作为馆藏补充体验，真正要长期维护的还是文章、项目和索引等实质内容。',
  },
];

const routes = [
  { title: 'RPG浏览模式大厅', note: '入口', href: '/rpg' },
  { title: '博客', note: '博客文章与随笔记录', href: '/blog' },
  { title: '游戏室', note: '试作与 demo', href: '/games' },
  { title: '相关信息', note: '关于与站点说明', href: '/about' },
];
---

<BaseLayout title="首页">
  <section class="shell hero page-block">
    <div class="hero-grid">
      <div class="hero-copy card-surface stack">
        <p class="eyebrow">Library · Reading Room · Archive</p>
        <h1>这很调和的博客</h1>
        <p class="intro">
          点击博客可以查看近期文章，全站搜索请按“Ctrl+K”或“/”快捷键打开或点击右上角的标记，
          专题书架是博主整理的特殊分类组，游戏选项可能会放置一些游戏的小demo，
          如果想再看看博主的介绍，可以点击关于此博客，或者继续向下看看。
        </p>

        <div class="actions">
          <Button href="/rpg" variant="primary">进入 RPG 浏览 </Button>
          <Button href="/blog">进入 传统 浏览</Button>
        </div>

        <div class="stat-row" aria-label="站点概览">
          {stats.map((item) => (
            <div class="stat-chip">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        <div class="hero-bottom">
          <p class="soft-note">RPG模式为馆藏浏览提供更好的体验，感兴趣的朋友可点击上方进入RPG浏览</p>
        </div>
      </div>

      <aside class="card-surface catalog-panel" aria-label="馆内导览">
        <div class="stack panel-head">
          <p class="panel-kicker">这是一张冗余设计的小卡片，但是放在这里感觉很合适</p>
          <h2>点击打开按钮可以进入对应页面</h2>
        </div>

        <div class="route-map" aria-hidden="true">
          <div class="route-node hall current">大厅</div>
          <div class="route-link left"></div>
          <div class="route-link right"></div>
          <div class="route-link down"></div>
          <div class="route-node library">图书馆</div>
          <div class="route-node game">游戏室</div>
          <div class="route-node archive">档案柜</div>
        </div>

        <ul class="catalog-list">
          {routes.map((route) => (
            <li>
              <strong>{route.title}</strong>
              <span>{route.note}</span>
              <a href={withBase(route.href)}>打开</a>
            </li>
          ))}
        </ul>

        <div class="tag-strip">
          {tags.map((tag) => (
            <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>{tag}</a>
          ))}
        </div>

        <div class="quote-box">
          <p>最上方是RPG浏览模式大厅的简单导引，感兴趣的朋友可以点击RPG浏览模式大厅选项卡的打开按钮试试</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="shell page-block principles-block">
    <SectionTitle
      eyebrow="该站近期更新和计划更新的内容"
      title="施工进度"
      intro="计划未来更新：站内小游戏，站内可视化动画浏览功能。下方为已实装的更新内容。"
    />

    <div class="info-grid three">
      {principles.map((item) => (
        <article class="info-card card-surface principle-card">
          <p class="info-kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell page-block">
    <SectionTitle
      eyebrow="点击对应选项卡即可进入页面"
      title="功能导引"
      intro="其实点右上角的按钮也可以啦……"
    />

    <div class="entry-grid">
      {rooms.map((room) => <EntryCard {...room} />)}
    </div>
  </section>

  <section class="shell page-block catalog-block">
    <SectionTitle
      eyebrow="中图分类法已实装于博客"
      title="馆藏目录"
      intro="中图分类浩如烟海，希望没有遗漏。此栏会出现常用的分类目录。"
    />

    <div class="catalog-home-grid">
      <div class="catalog-cards">
        {activeCatalog.map((node) => <CatalogCard node={node} compact />)}
      </div>

      <aside class="card-surface catalog-side-note">
        <p class="side-kicker">分类入口</p>
        <h3>中图分类入口</h3>
        <p>这么多的分类，不打开完整目录看看吗？</p>
        <div class="side-links">
          <a href={withBase('/catalog')} class="pill-link">打开完整目录</a>
          <a href={withBase('/archive')} class="pill-link">去归档页</a>
        </div>
      </aside>
    </div>
  </section>


  <section class="shell page-block shelves-block">
    <SectionTitle
      eyebrow="博主整理的专题合集"
      title="专题推荐"
      intro="馆藏还是太多了，使用专题和检索两个功能整理内容才能节省精力。"
    />

    <div class="shelves-home-grid">
      <div class="shelves-home-list">
        {shelves.map((shelf) => <ShelfCard shelf={shelf} compact />)}
      </div>
      <aside class="card-surface catalog-side-note">
        <p class="side-kicker">相关的内容要做成合订本</p>
        <h3>专题入口</h3>
        <p>有些相关联的内容分散在不同分类里，放在同一个专题里会更利于学习与寻找。</p>
        <div class="side-links">
          <a href={withBase('/shelves')} class="pill-link">打开全部专题书架</a>
          <a href={withBase('/search?q=建站')} class="pill-link">试试相关检索</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="shell page-block recent-block">
    <div class="recent-head">
      <SectionTitle
        eyebrow="最近文章"
        title="最近更新"
        intro="等不及了，快点端上来罢"
      />
      <div class="recent-actions">
        <a href={withBase('/archive')} class="pill-link">查看完整归档</a>
        <a href={withBase('/blog')} class="pill-link">进入博客目录</a>
      </div>
    </div>

    <div class="recent-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <style>
    .hero {
      padding-top: 2rem;
      padding-bottom: 1rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.42fr) minmax(19rem, 0.92fr);
      gap: 1rem;
      align-items: stretch;
    }

    .hero-copy,
    .catalog-panel {
      padding: 1.5rem;
      min-height: 100%;
    }

    .hero-copy {
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 38%),
        color-mix(in srgb, var(--panel) 90%, white 10%);
    }

    .eyebrow,
    .panel-kicker {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    h1 {
      margin: 0;
      font-size: clamp(3rem, 7vw, 5.4rem);
      line-height: 0.98;
      letter-spacing: 0.01em;
    }

    .intro,
    .soft-note,
    .quote-box p,
    .principle-card p:last-child {
      margin: 0;
      color: var(--text-muted);
    }

    .intro {
      font-size: 1.08rem;
      max-width: 40rem;
    }

    .actions,
    .recent-actions {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .stat-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .stat-chip {
      display: grid;
      gap: 0.2rem;
      padding: 0.8rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .stat-chip strong {
      font-size: 1.25rem;
      line-height: 1;
    }

    .stat-chip span {
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    .hero-bottom {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .soft-note {
      max-width: 30rem;
      font-size: 0.96rem;
    }

    .catalog-panel {
      display: grid;
      gap: 1rem;
      align-content: start;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.2), transparent 32%),
        color-mix(in srgb, var(--panel-strong) 88%, white 12%);
    }

    .panel-head,
    .route-map,
    .catalog-list,
    .tag-strip,
    .quote-box {
      position: relative;
      z-index: 1;
    }

    .panel-head h2,
    .catalog-list,
    .catalog-list li,
    .quote-box p {
      margin: 0;
    }

    .route-map {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      align-items: center;
      min-height: 10.5rem;
      padding: 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px dashed color-mix(in srgb, var(--line-strong) 84%, white 16%);
      background: color-mix(in srgb, var(--panel) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .route-node {
      display: grid;
      place-items: center;
      min-height: 3rem;
      padding: 0.35rem 0.6rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel-strong) 90%, white 10%);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .route-node.current {
      color: var(--text);
      border-color: color-mix(in srgb, var(--accent) 24%, var(--line) 76%);
      background: color-mix(in srgb, var(--accent-soft) 44%, white 56%);
      font-weight: 700;
    }

    .route-node.hall { grid-column: 2; grid-row: 1; }
    .route-node.library { grid-column: 1; grid-row: 2; }
    .route-node.game { grid-column: 3; grid-row: 2; }
    .route-node.archive { grid-column: 2; grid-row: 3; }

    .route-link {
      justify-self: center;
      align-self: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent) 14%, var(--line) 86%);
    }

    .route-link.left,
    .route-link.right {
      width: 100%;
      height: 2px;
      grid-row: 2;
    }

    .route-link.left { grid-column: 2; transform: translateX(-34%); }
    .route-link.right { grid-column: 2; transform: translateX(34%); }
    .route-link.down {
      width: 2px;
      height: 100%;
      grid-column: 2;
      grid-row: 2;
      transform: translateY(34%);
    }

    .catalog-list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: 0.85rem;
    }

    .catalog-list li {
      display: grid;
      gap: 0.18rem;
      padding: 0.9rem 0.95rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel) 90%, white 10%);
      box-shadow: var(--shadow-soft);
    }

    .catalog-list span,
    .catalog-list a {
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .catalog-list a {
      color: var(--accent);
      justify-self: start;
      margin-top: 0.15rem;
    }

    .tag-strip {
      display: flex;
      gap: 0.55rem;
      flex-wrap: wrap;
    }

    .tag-strip a {
      display: inline-flex;
      align-items: center;
      min-height: 2.1rem;
      padding: 0 0.75rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel) 88%, white 12%);
      color: var(--text-muted);
      font-size: 0.84rem;
    }

    .quote-box {
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px dashed color-mix(in srgb, var(--line-strong) 86%, white 14%);
      background: color-mix(in srgb, var(--accent-warm) 55%, white 45%);
    }

    .principles-block {
      padding-top: 0.5rem;
    }

    .principle-card {
      padding: 1.05rem 1.1rem;
      display: grid;
      gap: 0.65rem;
    }

    .principle-card h3 {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.25;
    }


    .catalog-home-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.82fr);
      gap: 1rem;
    }

    .catalog-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .catalog-side-note {
      padding: 1.2rem;
      display: grid;
      gap: 0.9rem;
      align-content: start;
    }

    .catalog-side-note > * {
      position: relative;
      z-index: 1;
    }

    .side-kicker,
    .catalog-side-note p {
      margin: 0;
      color: var(--text-muted);
    }

    .side-kicker {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .catalog-side-note h3 {
      margin: 0;
      font-size: 1.3rem;
      line-height: 1.25;
    }

    .side-links {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .entry-grid,
    .recent-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }


    .shelves-home-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.82fr);
      gap: 1rem;
    }

    .shelves-home-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .recent-head {
      display: flex;
      gap: 1rem;
      align-items: end;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    @media (max-width: 980px) {
      .shelves-home-grid,
      .shelves-home-list {
        grid-template-columns: 1fr;
      }

      .hero-grid,
      .entry-grid,
      .recent-grid,
      .catalog-home-grid,
      .catalog-cards {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .stat-row {
        grid-template-columns: 1fr;
      }

      .route-map {
        min-height: 11.5rem;
      }
    }
  </style>
</BaseLayout>
