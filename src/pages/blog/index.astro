---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPostTags, getPublishedPosts } from '@/features/blog/api/posts';
import { withBase } from '@/utils/paths';

const posts = await getPublishedPosts();
const tags = await getPostTags();
---

<PageLayout
  title="博客"
  description="文章目录"
  intro="这里是正常浏览入口。即使不进入 RPG 模式，也能顺畅访问全部内容。"
>
  <div class="section-toolbar">
    <a href={withBase('/archive')} class="pill-link">查看归档</a>
    <a href={withBase('/rpg')} class="pill-link">前往 RPG 入口</a>
  </div>

  {tags.length > 0 && (
    <div class="tag-cloud card-surface">
      <p class="cloud-title">常用标签</p>
      <div class="cloud-links">
        {tags.map((tag) => (
          <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>{tag}</a>
        ))}
      </div>
    </div>
  )}

  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <style>
    .tag-cloud {
      padding: 1rem 1.1rem;
      margin-bottom: 1.25rem;
    }

    .cloud-title {
      margin: 0 0 0.85rem;
      color: var(--text-muted);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      position: relative;
      z-index: 1;
    }

    .cloud-links {
      position: relative;
      z-index: 1;
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .cloud-links a {
      display: inline-flex;
      align-items: center;
      min-height: 2.2rem;
      padding: 0 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      color: var(--text-muted);
      transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .cloud-links a:hover {
      color: var(--text);
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--accent) 18%, var(--line) 82%);
    }

    .post-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 760px) {
      .post-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PageLayout>
