---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPostTags, getPublishedPosts } from '@/features/blog/api/posts';
import { withBase } from '@/utils/paths';

const posts = await getPublishedPosts();
const tags = await getPostTags();

const overview = [
  { label: '文章数量', value: String(posts.length).padStart(2, '0') },
  { label: '标签数量', value: String(tags.length).padStart(2, '0') },
  { label: '浏览方式', value: '简洁' },
];
---

<PageLayout
  title="博客"
  description="文章目录"
  intro="这里是正常浏览入口。即使不进入 RPG 模式，也能顺畅访问全部内容。"
>
  <div class="section-toolbar">
    <a href={withBase('/archive')} class="pill-link">查看归档</a>
    <a href={withBase('/rpg')} class="pill-link">前往 RPG 入口</a>
  </div>

  <div class="overview-grid info-grid three">
    {overview.map((item) => (
      <div class="info-card card-surface overview-card">
        <p class="info-kicker">{item.label}</p>
        <strong>{item.value}</strong>
      </div>
    ))}
  </div>

  {tags.length > 0 && (
    <div class="tag-cloud card-surface">
      <div class="cloud-head">
        <p class="cloud-title">常用标签</p>
        <p class="cloud-note">标签页暂时还不复杂，但已经能承担目录分流。</p>
      </div>
      <div class="cloud-links">
        {tags.map((tag) => (
          <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>{tag}</a>
        ))}
      </div>
    </div>
  )}

  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <style>
    .overview-card {
      display: grid;
      gap: 0.3rem;
      padding: 1rem 1.05rem;
    }

    .overview-card strong {
      font-size: 1.45rem;
      line-height: 1;
    }

    .tag-cloud {
      padding: 1rem 1.1rem;
      margin-bottom: 1.25rem;
    }

    .cloud-head,
    .cloud-links {
      position: relative;
      z-index: 1;
    }

    .cloud-head {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-bottom: 0.85rem;
    }

    .cloud-title,
    .cloud-note {
      margin: 0;
    }

    .cloud-title {
      color: var(--text-muted);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .cloud-note {
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .cloud-links {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .cloud-links a {
      display: inline-flex;
      align-items: center;
      min-height: 2.2rem;
      padding: 0 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      color: var(--text-muted);
      transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .cloud-links a:hover {
      color: var(--text);
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--accent) 18%, var(--line) 82%);
    }

    .post-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 760px) {
      .post-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PageLayout>
