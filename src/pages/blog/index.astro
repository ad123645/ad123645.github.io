---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import CatalogCard from '@/components/catalog/CatalogCard.astro';
import { getPostTags, getPostsGroupedByTopCatalog, getPublishedPosts } from '@/features/blog/api/posts';
import { getTopLevelCatalogNodesFromPosts } from '@/features/catalog/helpers';
import { catalogByCode } from '@/data/catalog/clc';
import { formatDate } from '@/utils/date';
import { withBase } from '@/utils/paths';

const posts = await getPublishedPosts();
const tags = await getPostTags();
const [featured, ...rest] = posts;
const topCatalog = getTopLevelCatalogNodesFromPosts(posts);
const groupedByShelf = [...getPostsGroupedByTopCatalog(posts).entries()]
  .flatMap(([code, items]) => {
    const node = catalogByCode.get(code);
    return node ? [{ code, node, posts: items }] : [];
  })
  .sort((a, b) => b.posts.length - a.posts.length || a.code.localeCompare(b.code, 'zh-CN'));

const overview = [
  { label: '文章数量', value: String(posts.length).padStart(2, '0') },
  { label: '标签数量', value: String(tags.length).padStart(2, '0') },
  { label: '活跃书架', value: String(topCatalog.length).padStart(2, '0') },
];
---

<PageLayout
  title="博客"
  description="文章目录"
  intro="这里是正常浏览入口。即使不进入 RPG 模式，也能顺畅访问全部内容，并按馆藏目录或标签寻找文章。"
>
  <div class="section-toolbar">
    <a href={withBase('/archive')} class="pill-link">查看归档</a>
    <a href={withBase('/catalog')} class="pill-link">浏览馆藏目录</a>
    <a href={withBase('/rpg')} class="pill-link">前往 RPG 入口</a>
  </div>

  <div class="overview-grid info-grid three">
    {overview.map((item) => (
      <div class="info-card card-surface overview-card">
        <p class="info-kicker">{item.label}</p>
        <strong>{item.value}</strong>
      </div>
    ))}
  </div>

  <section class="lead-grid">
    {featured && (
      <article class="card-surface featured-post">
        <div class="featured-copy">
          <p class="feature-kicker">最近整理</p>
          <h2>{featured.data.title}</h2>
          <p class="feature-desc">{featured.data.description}</p>
        </div>

        <div class="feature-meta">
          <div>
            <span>发布日期</span>
            <strong>{formatDate(featured.data.publishedAt)}</strong>
          </div>
          <div>
            <span>标签</span>
            <strong>{featured.data.tags.slice(0, 2).join(' · ') || '未分类'}</strong>
          </div>
        </div>

        <div class="feature-actions">
          <a href={withBase(`/blog/${featured.id}`)} class="pill-link">阅读这篇文章</a>
          <a href={withBase('/archive')} class="pill-link">查看完整归档</a>
        </div>
      </article>
    )}

    {tags.length > 0 && (
      <div class="tag-cloud card-surface">
        <div class="cloud-head">
          <p class="cloud-title">常用标签</p>
          <p class="cloud-note">标签像书签，馆藏目录像书架。两者现在会一起工作。</p>
        </div>
        <div class="cloud-links">
          {tags.map((tag) => (
            <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>{tag}</a>
          ))}
        </div>
      </div>
    )}
  </section>

  {topCatalog.length > 0 && (
    <section class="catalog-strip">
      <div class="catalog-strip-head">
        <p class="feature-kicker">馆藏浏览</p>
        <h2>目录不只是一张总表，也该长进文章列表里</h2>
        <p class="feature-desc">这些是当前最活跃的一级书架。完整总目录会保留全部一级与二级类目。</p>
      </div>
      <div class="catalog-strip-grid">
        {topCatalog.slice(0, 4).map((node) => <CatalogCard node={node} compact />)}
      </div>
    </section>
  )}

  <section class="shelf-browser card-surface">
    <div class="shelf-browser-head">
      <p class="feature-kicker">By shelf</p>
      <h2>也可以沿着书架一排排看</h2>
      <p class="feature-desc">这不是筛选器，而是另一种浏览节奏。先看整排，再翻单篇。</p>
    </div>
    <div class="shelf-jump">
      {groupedByShelf.map((group) => (
        <a href={`#shelf-${group.node.slug}`}>
          <span>{group.code}</span>
          <strong>{group.node.name}</strong>
          <em>{group.posts.length}</em>
        </a>
      ))}
    </div>
  </section>

  <div class="post-grid">
    {rest.length > 0 ? rest.map((post) => <PostCard post={post} />) : featured && <PostCard post={featured} />}
  </div>

  {groupedByShelf.length > 0 && (
    <section class="shelf-sections">
      {groupedByShelf.map((group) => (
        <article id={`shelf-${group.node.slug}`} class="shelf-section card-surface">
          <div class="shelf-section-head">
            <div>
              <p class="feature-kicker">Shelf section</p>
              <h2>{group.code} · {group.node.name}</h2>
            </div>
            <a href={withBase(`/catalog/${group.node.slug}`)} class="pill-link">打开这架目录</a>
          </div>
          <ul class="shelf-post-list">
            {group.posts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}`)}>
                  <strong>{post.data.title}</strong>
                  <p>{post.data.description}</p>
                  <span>{formatDate(post.data.publishedAt)}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  )}

  <style>
    .overview-card {
      display: grid;
      gap: 0.3rem;
      padding: 1rem 1.05rem;
    }

    .overview-card strong {
      font-size: 1.45rem;
      line-height: 1;
    }

    .lead-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.9fr);
      gap: 1rem;
      margin-bottom: 1.25rem;
      align-items: start;
    }

    .featured-post,
    .tag-cloud,
    .shelf-browser,
    .shelf-section {
      position: relative;
      padding: 1.15rem 1.2rem;
    }

    .featured-post > *,
    .tag-cloud > *,
    .shelf-browser > *,
    .shelf-section > * {
      position: relative;
      z-index: 1;
    }

    .featured-post {
      display: grid;
      gap: 1rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent 38%),
        color-mix(in srgb, var(--panel) 90%, white 10%);
    }

    .feature-kicker,
    .cloud-title,
    .cloud-note,
    .feature-desc,
    .feature-meta span,
    .shelf-post-list p,
    .shelf-post-list span {
      margin: 0;
      color: var(--text-muted);
    }

    .feature-kicker,
    .cloud-title {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .featured-copy {
      display: grid;
      gap: 0.45rem;
    }

    .featured-copy h2,
    .catalog-strip-head h2,
    .shelf-browser-head h2,
    .shelf-section-head h2 {
      margin: 0;
      font-size: clamp(1.45rem, 2.6vw, 2rem);
      line-height: 1.15;
    }

    .feature-desc,
    .cloud-note {
      font-size: 0.95rem;
    }

    .feature-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .feature-meta div {
      display: grid;
      gap: 0.25rem;
      padding: 0.85rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .feature-meta strong {
      font-size: 0.98rem;
      line-height: 1.3;
    }

    .feature-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .cloud-head,
    .cloud-links {
      position: relative;
      z-index: 1;
    }

    .cloud-head {
      display: grid;
      gap: 0.25rem;
      margin-bottom: 0.85rem;
    }

    .cloud-links,
    .shelf-jump {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .cloud-links a,
    .shelf-jump a {
      display: inline-flex;
      align-items: center;
      min-height: 2.2rem;
      padding: 0 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      color: var(--text-muted);
      transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .cloud-links a:hover,
    .shelf-jump a:hover {
      color: var(--text);
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--accent) 18%, var(--line) 82%);
    }

    .catalog-strip,
    .shelf-sections {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .catalog-strip-head,
    .shelf-browser-head {
      display: grid;
      gap: 0.35rem;
    }

    .catalog-strip-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .shelf-browser {
      display: grid;
      gap: 0.9rem;
      margin-bottom: 1.25rem;
    }

    .shelf-jump a {
      gap: 0.55rem;
    }

    .shelf-jump span:first-child {
      color: var(--text);
      font-weight: 600;
    }

    .shelf-jump em {
      color: var(--text-muted);
      font-style: normal;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .shelf-section {
      display: grid;
      gap: 0.9rem;
      scroll-margin-top: 1rem;
    }

    .shelf-section-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .shelf-post-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .shelf-post-list a {
      display: grid;
      gap: 0.4rem;
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 88%, white 12%);
      box-shadow: var(--shadow-soft);
    }

    .shelf-post-list strong {
      font-size: 1rem;
      line-height: 1.25;
    }

    .shelf-post-list p {
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .shelf-post-list span {
      font-size: 0.86rem;
    }

    @media (max-width: 980px) {
      .lead-grid,
      .catalog-strip-grid,
      .post-grid,
      .shelf-post-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .feature-meta {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PageLayout>
