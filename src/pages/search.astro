---
import PageLayout from '@/layouts/PageLayout.astro';
import SearchClient from '@/features/search/components/SearchClient';
import { buildSearchIndex } from '@/features/search/helpers/buildSearchIndex';

const { posts, catalogNodes, shelves, searchItems } = await buildSearchIndex();
const initialQuery = Astro.url.searchParams.get('q') || '';

const counts = [
  { label: '可检索条目', value: String(searchItems.length).padStart(2, '0') },
  { label: '文章', value: String(posts.length).padStart(2, '0') },
  { label: '专题书架', value: String(shelves.length).padStart(2, '0') },
  { label: '分类节点', value: String(catalogNodes.length).padStart(2, '0') },
];
---

<PageLayout
  title="检索"
  description="搜索文章、馆藏目录、标签与页面"
  intro="把站点当作一座真正可检索的小馆。这里可以同时搜文章、馆藏分类、标签、单页、游戏和专题书架。"
>
  <div class="overview-grid info-grid three wide-grid">
    {counts.map((item) => (
      <div class="info-card card-surface overview-card">
        <p class="info-kicker">{item.label}</p>
        <strong>{item.value}</strong>
      </div>
    ))}
  </div>

  <SearchClient client:load items={searchItems} initialQuery={initialQuery} />

  <noscript>
    <section class="result-panel card-surface">
      <div class="result-head">
        <p class="result-title">检索结果</p>
        <p class="result-state">当前浏览器未启用脚本，先提供馆内入口索引。</p>
      </div>
      <div class="result-list">
        {searchItems.slice(0, 18).map((item) => (
          <a class="result-card" href={item.href}>
            <div class="result-card-head">
              <span class="result-group">{item.group}</span>
              <strong>{item.title}</strong>
            </div>
            <p>{item.meta}</p>
          </a>
        ))}
      </div>
    </section>
  </noscript>

  <style>
    .wide-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .overview-card { display: grid; gap: 0.3rem; }
    .overview-card strong { font-size: 1.45rem; line-height: 1; }
    .result-panel { padding: 1.15rem 1.2rem; }
    .result-head { display: grid; gap: 0.35rem; margin-bottom: 1rem; }
    .result-title {
      margin: 0;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--text-muted);
    }
    .result-state { margin: 0; color: var(--text-muted); }
    .result-list {
      display: grid;
      gap: 0.85rem;
      min-height: 8rem;
    }
    .result-card {
      display: grid;
      gap: 0.35rem;
      padding: 0.95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--line) 88%, white 12%);
      background: color-mix(in srgb, var(--panel-strong) 90%, white 10%);
      box-shadow: var(--shadow-soft);
      text-decoration: none;
      color: inherit;
    }
    .result-card-head { display: grid; gap: 0.25rem; }
    .result-group {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      min-height: 1.6rem;
      padding: 0 0.55rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-soft) 62%, white 38%);
      color: var(--text-muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .result-card p { margin: 0; color: var(--text-muted); }
    @media (max-width: 980px) { .wide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 700px) { .wide-grid { grid-template-columns: 1fr; } }
  </style>
</PageLayout>
