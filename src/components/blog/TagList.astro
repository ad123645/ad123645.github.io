---
import Badge from '@/components/ui/Badge.astro';
import { withBase } from '@/utils/paths';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <div class="tags">
    {
      tags.map((tag) => (
        <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>
          <Badge>{tag}</Badge>
        </a>
      ))
    }
  </div>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
