---
interface Props {
  tone?: 'default' | 'accent';
}

const { tone = 'default' } = Astro.props;
---

<span class={`badge ${tone}`}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .accent {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }
</style>
