---
import Nav from '@/components/site/Nav.astro';
import { siteConfig } from '@/data/site';
import { withBase } from '@/utils/paths';
---

<header class="site-header">
  <div class="shell header-shell">
    <div class="header-inner card-surface">
      <a class="brand" href={withBase('/')}>
        <span class="brand-kicker">Personal archive</span>
        <span class="brand-title">{siteConfig.title}</span>
        <span class="brand-subtitle">{siteConfig.subtitle}</span>
      </a>

      <div class="header-right">
        <div class="utility-row">
          <p class="status-pill">Catalog in place</p>
          <a class="search-pill" href={withBase('/search')} aria-label="打开检索页">
            <span>检索</span>
            <kbd>⌘K</kbd>
          </a>
        </div>
        <Nav />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-top: 0.9rem;
  }

  .header-shell {
    position: relative;
  }

  .header-inner {
    min-height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--panel) 85%, white 15%);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: grid;
    gap: 0.12rem;
  }

  .brand-kicker {
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .brand-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .brand-subtitle {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .header-right {
    display: grid;
    justify-items: end;
    gap: 0.55rem;
  }

  .utility-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .status-pill,
  .search-pill {
    margin: 0;
    display: inline-flex;
    align-items: center;
    min-height: 1.95rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--line) 82%, white 18%);
    background: color-mix(in srgb, var(--panel-strong) 82%, white 18%);
    color: var(--text-muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: var(--shadow-soft);
  }

  .search-pill {
    gap: 0.55rem;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .search-pill:hover {
    transform: translateY(-1px);
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--line) 76%);
    background: color-mix(in srgb, var(--accent-soft) 28%, white 72%);
  }

  .search-pill kbd {
    display: inline-flex;
    align-items: center;
    min-height: 1.25rem;
    padding: 0 0.42rem;
    border-radius: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--line) 78%, white 22%);
    background: color-mix(in srgb, var(--panel) 80%, white 20%);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  @media (max-width: 760px) {
    .site-header {
      padding-top: 0.6rem;
    }

    .header-inner {
      align-items: start;
      flex-direction: column;
      padding: 0.9rem;
    }

    .header-right {
      width: 100%;
      justify-items: start;
    }

    .utility-row {
      justify-content: flex-start;
    }
  }
</style>
